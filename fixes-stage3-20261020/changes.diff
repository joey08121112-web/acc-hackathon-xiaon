+export type PlanTask = {
+  day: string;
+  title: string;
+  note: string;
+  mins: number;
+  taskId?: string;
+};
+export type PlanDraft = {
+  eyebrow: string;
+  goal: string;
+  note: string;
+  tasks: PlanTask[];
+};
+export function nextNewCalcId(s: State): string {
+  return (
+    [
+      "transfer",
+      ...tasks.filter((t) => t.id.startsWith("calc-")).map((t) => t.id),
+    ].find((id) => !s.calcSeen.includes(id)) || "transfer"
+  );
 }
+// 周计划按计算维观察结果分流：有符号错误时先补这个环节，
+// 已能独立完成时转向巩固与检验，避免给所有学生同一份固定建议。
+export function planDraft(s: State): PlanDraft {
+  const calc = observations(s)[2];
+  if (calc.status === "多次独立完成")
+    return {
+      eyebrow: "根据当前计算任务记录",
+      goal: "把去括号的方法用活",
+      note: "你已经在不同的题里独立完成。这周试试把方法讲清楚，再编一道题考考自己。",
+      tasks: [
+        {
+          day: "第 1 次",
+          title: "再检验一道同类新题",
+          note: "约 3 分钟 · 保持不提示",
+          mins: 3,
+          taskId: nextNewCalcId(s),
+        },
+        {
+          day: "第 2 次",
+          title: "自己编一道去括号题",
+          note: "约 3 分钟 · 写出题目和解答",
+          mins: 3,
+        },
+      ],
+    };
+  if (calc.status === "本次独立完成")
+    return {
+      eyebrow: "根据当前计算任务记录",
+      goal: "站稳去括号这一步",
+      note: "这次你独立完成了。再换一道新题，看看是不是每次都稳。",
+      tasks: [
+        {
+          day: "第 1 次",
+          title: "换一道同类新题，自己试试",
+          note: "约 3 分钟 · 优先不提示",
+          mins: 3,
+          taskId: nextNewCalcId(s),
+        },
+        {
+          day: "第 2 次",
+          title: "回看方法，复述关键一步",
+          note: "约 2 分钟",
+          mins: 2,
+        },
+      ],
+    };
+  return {
+    eyebrow: calc.basis.length
+      ? "根据当前计算任务记录"
+      : "尚无作答依据 · 可选建议目标",
+    goal: "看清括号前的负号",
+    note: "先圈符号，再逐项去括号。用新题看看，能不能自己处理好。",
+    tasks: [
+      {
+        day: "第 1 次",
+        title: "一起观察一个括号",
+        note: "约 3 分钟 · 原题尝试与提示",
+        mins: 3,
+        taskId: "bracket",
+      },
+      {
+        day: "第 2 次",
+        title: "换一道同类新题",
+        note: "约 3 分钟 · 优先自己试试",
+        mins: 3,
+        taskId: "transfer",
+      },
+      {
+        day: "第 3 次",
+        title: "回看方法，整理小发现",
+        note: "约 2 分钟 · 复述关键步骤",
+        mins: 2,
+      },
+    ],
+  };
+}
