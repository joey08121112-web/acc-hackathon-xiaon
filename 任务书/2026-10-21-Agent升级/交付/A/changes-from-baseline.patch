+   if(!hosts.has(req.headers.host??''))throw new RuntimeError('forbidden','不接受此 Host');
+   const path=new URL(req.url??'/','http://127.0.0.1').pathname;
+   if(req.method==='GET'&&path==='/api/health'){send({schemaVersion:SCHEMA_VERSION,status:'ok',mode:runtime.provider.kind==='offline'?'local_rules':'model',providerKind:runtime.provider.kind,disclosure:MODEL_DISCLOSURE});return;}
+   if(req.method==='POST'){
+    if(!allowed.has(req.headers.origin??'')||req.headers['sec-fetch-site']==='cross-site')throw new RuntimeError('forbidden','写操作需要允许的本机 Origin');
